[Unit]
Description=Razer JIT Fn-Key Layer Fix Daemon
After=dev-uinput.device
Documentation=https://github.com/Adam-AtlasSoftware/razer-fn-fix

[Service]
Type=simple
ExecStart=/usr/bin/razer_driver -f
Restart=always
RestartSec=3s
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/dev/input /dev/uinput /dev /etc/razer-fn
PrivateTmp=true
CapabilityBoundingSet=CAP_SYS_ADMIN
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
